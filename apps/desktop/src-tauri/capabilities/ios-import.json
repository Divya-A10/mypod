{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ios-audio-import",
  "description": "Allows user-selected audio to be staged in MyPod's private library on iOS.",
  "local": true,
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-start-accessing-security-scoped-resource",
    "fs:allow-stop-accessing-security-scoped-resource",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPLOCALDATA/MyPod/Importing" },
        { "path": "$APPLOCALDATA/MyPod/Importing/**" },
        { "path": "$APPLOCALDATA/MyPod/Backups" },
        { "path": "$APPLOCALDATA/MyPod/Backups/**" }
      ]
    }
  ]
}
